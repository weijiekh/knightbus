APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/knightbus
TRAINING_IN_WORKER=true
REALTIME_RETENTION_DAYS=14
RAW_SNAPSHOT_RETENTION_DAYS=1
GTFS_FEEDS=[{"name":"rapid-bus-kl","static_url":"https://api.data.gov.my/gtfs-static/prasarana?category=rapid-bus-kl","vehicle_positions_url":"https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-kl"},{"name":"rapid-bus-mrtfeeder","static_url":"https://api.data.gov.my/gtfs-static/prasarana?category=rapid-bus-mrtfeeder","vehicle_positions_url":"https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-mrtfeeder"},{"name":"rapid-bus-penang","static_url":"https://api.data.gov.my/gtfs-static/prasarana?category=rapid-bus-penang","vehicle_positions_url":"https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-penang"}]
# Legacy single-feed config (used if GTFS_FEEDS is not set):
# GTFS_STATIC_URL=https://api.data.gov.my/gtfs-static/prasarana?category=rapid-bus-kl
# GTFS_VEHICLE_POSITIONS_URL=https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-kl
# GTFS_TRIP_UPDATES_URL=
GTFS_REQUEST_TIMEOUT_SECONDS=20
GTFS_POLL_INTERVAL_SECONDS=30
GTFS_SERVICE_TIMEZONE=Asia/Kuala_Lumpur
GTFS_ACTIVE_POLL_START_LOCAL=06:00
GTFS_ACTIVE_POLL_END_LOCAL=00:00
GTFS_OFF_HOURS_POLL_INTERVAL_SECONDS=900
GTFS_STATIC_REFRESH_HOURS=24
FEATURE_REFRESH_MINUTES=5
TRAINING_REFRESH_HOURS=24
